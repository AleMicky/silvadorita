---
import Logo from './Logo.astro';
import { heroData } from '../data/company';

const mineralElements = [
  {
    atomicNumber: '74',
    symbol: 'W',
    name: 'Wolframio',
    subtitle: 'Tungsteno · Alta densidad',
    mass: '183.84 u',
    image: '/images/mineral-wolframio.jpg',
  },
  {
    atomicNumber: '50',
    symbol: 'Sn',
    name: 'Estaño',
    subtitle: 'Casiterita · Vetas andinas',
    mass: '118.71 u',
    image: '/images/mineral-estano.jpg',
  },
  {
    atomicNumber: '79',
    symbol: 'Au',
    name: 'Oro',
    subtitle: 'Metal noble · Alta pureza',
    mass: '196.97 u',
    image: '/images/mineral-oro.jpg',
  },
];

const stats = [
  { value: 2016, prefix: '', suffix: '', label: 'Año de Constitución', detail: '22 de abril · Cochabamba' },
  { value: 3, prefix: '0', suffix: '', label: 'Áreas Mineras', detail: 'La Poderosa, Mi Triunfo y San Esteban' },
  { value: 6, prefix: '0', suffix: '', label: 'Vetas Identificadas', detail: 'Falda noreste Cerro Chicote Grande' },
  { value: 1333, prefix: 'Ley ', suffix: '', label: 'Gestión Ambiental', detail: 'Adecuación AJAM y licencia EMAP' },
];
---

<section class="relative min-h-svh flex flex-col justify-between pt-24 pb-12 sm:pt-32 sm:pb-16 lg:pt-36 lg:pb-20 overflow-hidden bg-[#060a12]">
  <!-- Full-Screen Cinematic Andean Mine Background Image -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <img
      src="/images/hero-andes-mine.jpg"
      alt="Operación minera en la cordillera andina - Cerro Chicote Grande"
      class="animate-ken-burns w-full h-full object-cover object-center opacity-50"
      loading="eager"
    />
    <!-- Multi-layer Dark Industrial & Golden Vignette Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#060a12]/85 via-[#060a12]/55 to-[#060a12]"></div>
    <div class="absolute inset-0 bg-radial from-transparent via-[#060a12]/40 to-[#060a12]/90"></div>

    <!-- Animated Topographic SVG Contours over the mountain backdrop -->
    <svg
      class="animate-topo absolute inset-0 w-full h-full opacity-[0.16]"
      viewBox="0 0 1440 900"
      fill="none"
      preserveAspectRatio="xMidYMid slice"
    >
      <path
        d="M-100 650 C 220 520, 440 740, 760 580 C 1080 420, 1250 610, 1540 490"
        stroke="url(#goldLine1)"
        stroke-width="1.5"
        stroke-dasharray="8 8"
      />
      <path
        d="M-100 550 C 260 400, 510 660, 820 480 C 1120 300, 1290 520, 1540 380"
        stroke="url(#goldLine1)"
        stroke-width="1.2"
      />
      <defs>
        <linearGradient id="goldLine1" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="rgba(212,175,55,0)" />
          <stop offset="50%" stop-color="rgba(245,223,144,0.75)" />
          <stop offset="100%" stop-color="rgba(212,175,55,0)" />
        </linearGradient>
      </defs>
    </svg>
  </div>

  <!-- Main Centered Hero Content -->
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full my-auto">
    <div class="flex flex-col items-center text-center">
      <!-- Floating Dark-Glass Emblem -->
      <div class="reveal is-visible mb-4 sm:mb-6 animate-float-badge">
        <Logo variant="hero-emblem" />
      </div>

      <!-- Eyebrow Capsule -->
      <div class="reveal is-visible delay-100 inline-flex items-center justify-center gap-2 px-3.5 sm:px-4 py-1.5 rounded-full bg-[#090f1d]/80 border border-[#d4af37]/40 backdrop-blur-md mb-5 sm:mb-6 shadow-lg max-w-full">
        <span class="w-2 h-2 rounded-full bg-[#f5df90] animate-ping shrink-0" style="animation-duration: 2.2s;"></span>
        <span class="font-mono-tech text-[10px] sm:text-xs font-semibold tracking-[0.12em] sm:tracking-[0.2em] text-[#f5df90] uppercase truncate">
          {heroData.eyebrow}
        </span>
      </div>

      <!-- High-Impact Full-Width Display Headline -->
      <h1 class="reveal is-visible delay-200 font-display text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.1] sm:leading-[1.06] max-w-4xl drop-shadow-[0_8px_30px_rgba(0,0,0,0.8)]">
        <span class="text-white">Minería boliviana de </span>
        <span class="text-gold-gradient block sm:inline mt-1 sm:mt-0">wolframio, estaño y oro</span>
      </h1>

      <!-- Subtitle from PDF -->
      <p class="reveal is-visible delay-300 mt-4 sm:mt-6 text-sm sm:text-lg lg:text-xl text-slate-200 max-w-2xl leading-relaxed font-normal drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)] px-1">
        {heroData.description}
      </p>

      <!-- Action Buttons (Full width on mobile, inline on sm+) -->
      <div class="reveal is-visible delay-300 mt-7 sm:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4 w-full sm:w-auto max-w-md sm:max-w-none">
        <a
          href="#areas-mineras"
          class="inline-flex items-center justify-center gap-2.5 px-6 sm:px-7 py-3.5 rounded-full text-sm font-bold text-[#060a12] bg-gradient-to-r from-[#f5df90] via-[#d4af37] to-[#b8860b] hover:brightness-110 shadow-[0_0_30px_rgba(212,175,55,0.45)] transition-all duration-300"
        >
          <span>Explorar Áreas Mineras</span>
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
        <a
          href="#datos-empresa"
          class="inline-flex items-center justify-center gap-2.5 px-6 sm:px-7 py-3.5 rounded-full text-sm font-semibold text-white bg-[#090f1d]/75 hover:bg-[#090f1d] border border-white/20 hover:border-[#d4af37]/60 backdrop-blur-md transition-all duration-300 shadow-lg"
        >
          <span>Ficha Corporativa</span>
          <span class="font-mono-tech text-xs text-[#f5df90]">NIT 313716027</span>
        </a>
      </div>

      <!-- 3D Periodic Element Mineral Cards with Macro Photography -->
      <div class="reveal is-visible delay-400 mt-10 sm:mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 w-full max-w-4xl">
        {
          mineralElements.map((item, idx) => (
            <div
              data-tilt
              class:list={[
                'bento-card tilt-card rounded-2xl overflow-hidden text-left group cursor-default',
                idx === 2 ? 'sm:col-span-2 lg:col-span-1' : '',
              ]}
            >
              <!-- Mineral Specimen Photo Header -->
              <div class="relative h-28 sm:h-32 w-full overflow-hidden">
                <img
                  src={item.image}
                  alt={`Mineral de ${item.name} (${item.symbol})`}
                  class="w-full h-full object-cover object-center group-hover:scale-110 transition-transform duration-700"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#090f1d] via-[#090f1d]/25 to-transparent"></div>
                <div class="absolute top-3 right-3 px-2.5 py-1 rounded-lg bg-[#060a12]/80 backdrop-blur-md border border-[#d4af37]/40 flex items-center gap-1.5">
                  <span class="font-display text-sm font-black text-[#f5df90]">{item.symbol}</span>
                  <span class="font-mono-tech text-[10px] text-slate-300">#{item.atomicNumber}</span>
                </div>
              </div>

              <div class="relative z-10 p-4 pt-2 flex items-end justify-between gap-2">
                <div class="min-w-0">
                  <h2 class="font-display text-base sm:text-lg font-bold text-white group-hover:text-[#f5df90] transition-colors truncate">
                    {item.name}
                  </h2>
                  <p class="text-xs text-slate-400 mt-0.5 truncate">{item.subtitle}</p>
                </div>
                <span class="font-mono-tech text-[10px] text-[#d4af37] bg-[#d4af37]/10 px-2 py-0.5 rounded border border-[#d4af37]/20 shrink-0">
                  {item.mass}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Animated Counters Bar -->
    <div class="reveal delay-400 mt-8 sm:mt-14 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6 bg-[#060a12]/70 backdrop-blur-md rounded-2xl sm:rounded-3xl p-4 sm:p-6 border border-white/15">
      {
        stats.map((stat) => (
          <div class="text-center sm:text-left p-2 sm:px-3 sm:py-1 rounded-xl">
            <div
              data-counter={stat.value}
              data-prefix={stat.prefix}
              data-suffix={stat.suffix}
              class="font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold text-gold-gradient tracking-tight"
            >
              {stat.prefix}{stat.value}{stat.suffix}
            </div>
            <div class="text-xs sm:text-sm font-bold text-white mt-1 leading-snug">{stat.label}</div>
            <div class="font-mono-tech text-[10px] sm:text-[11px] text-slate-400 mt-0.5 leading-tight">{stat.detail}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
