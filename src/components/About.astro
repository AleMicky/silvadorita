---
import { aboutData } from '../data/company';

const valueChainSteps = [
  { code: '01', name: 'Prospección' },
  { code: '02', name: 'Exploración' },
  { code: '03', name: 'Explotación' },
  { code: '04', name: 'Concentración' },
  { code: '05', name: 'Fundición' },
  { code: '06', name: 'Refinación' },
  { code: '07', name: 'Industrialización' },
  { code: '08', name: 'Comercialización' },
];
---

<section id="quienes-somos" class="scroll-mt-24 py-16 sm:py-24 lg:py-28 bg-[#080d18] relative overflow-hidden">
  <!-- Ambient Background Accent -->
  <div class="pointer-events-none absolute top-1/2 right-0 w-72 sm:w-96 h-72 sm:h-96 rounded-full bg-[#d4af37]/6 blur-[120px]" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="reveal flex flex-col md:flex-row md:items-end justify-between mb-10 sm:mb-14 gap-3 sm:gap-4">
      <div>
        <div class="inline-flex items-center gap-2.5 font-mono-tech text-[11px] sm:text-xs font-semibold tracking-[0.18em] sm:tracking-[0.2em] text-[#f5df90] uppercase mb-2.5 sm:mb-3">
          <span class="w-6 sm:w-8 h-[1.5px] bg-[#d4af37]"></span>
          <span>01 / IDENTIDAD CORPORATIVA</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          {aboutData.title}
        </h2>
      </div>
      <p class="font-mono-tech text-[11px] sm:text-xs text-slate-400 max-w-xs">
        TRADICIÓN FAMILIAR BOLIVIANA · COCHABAMBA & LA PAZ
      </p>
    </div>

    <!-- Asymmetric Bento Grid with Photography -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-6">
      <!-- Bento Block 1: Origen Familiar (7 columns on lg, 12 on md) -->
      <article
        data-tilt
        class="reveal delay-100 bento-card tilt-card md:col-span-12 lg:col-span-7 rounded-2xl sm:rounded-3xl p-5 sm:p-8 lg:p-9 flex flex-col justify-between"
      >
        <div class="relative z-10">
          <div class="flex flex-wrap items-center justify-between gap-2 sm:gap-3 mb-5 sm:mb-6">
            <span class="inline-flex items-center gap-2 px-3 sm:px-3.5 py-1 rounded-full bg-[#d4af37]/15 border border-[#d4af37]/30 font-mono-tech text-[11px] sm:text-xs font-semibold text-[#f5df90]">
              <span class="w-1.5 h-1.5 rounded-full bg-[#f5df90]"></span>
              ORIGEN E IDENTIDAD LEGAL
            </span>
            <span class="font-mono-tech text-[11px] sm:text-xs text-slate-400">S.R.L. · COCHABAMBA</span>
          </div>

          <h3 class="font-display text-xl sm:text-2xl lg:text-3xl font-bold text-white mb-3.5 sm:mb-4">
            Empresa minera boliviana de origen familiar
          </h3>

          <p class="text-sm sm:text-base lg:text-[16.5px] text-slate-300 leading-[1.75] sm:leading-[1.8]">
            <strong class="font-bold text-[#f5df90]">Empresa Minera "Silvadorita" S.R.L.</strong> es una empresa minera boliviana de origen familiar, constituida en la ciudad de Cochabamba el 22 de abril de 2016 como sociedad de responsabilidad limitada e inscrita en el Registro de Comercio desde el 12 de mayo de 2016.
          </p>
        </div>

        <!-- Mini Timeline Strip inside Bento 1 -->
        <div class="relative z-10 mt-6 sm:mt-8 pt-5 sm:pt-6 border-t border-white/10 grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div class="rounded-xl sm:rounded-2xl bg-white/[0.03] border border-white/[0.06] p-3.5 sm:p-4">
            <span class="font-mono-tech text-[11px] sm:text-xs text-[#f5df90] block">22 DE ABRIL DE 2016</span>
            <span class="text-xs sm:text-sm font-semibold text-white mt-1 block">Constitución como S.R.L. en Cochabamba</span>
          </div>
          <div class="rounded-xl sm:rounded-2xl bg-white/[0.03] border border-white/[0.06] p-3.5 sm:p-4">
            <span class="font-mono-tech text-[11px] sm:text-xs text-[#f5df90] block">12 DE MAYO DE 2016</span>
            <span class="text-xs sm:text-sm font-semibold text-white mt-1 block">Inscripción en el Registro de Comercio</span>
          </div>
        </div>
      </article>

      <!-- Bento Block 2: Photographic Showcase of Field Engineering & Operations -->
      <div
        data-tilt
        class="reveal delay-200 bento-card tilt-card md:col-span-6 lg:col-span-5 rounded-2xl sm:rounded-3xl overflow-hidden relative min-h-[280px] sm:min-h-[340px] flex flex-col justify-end group"
      >
        <img
          src="/images/about-mining.jpg"
          alt="Ingeniería minera y operaciones de transporte pesado y liviano en los Andes bolivianos"
          class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#060a12] via-[#060a12]/50 to-transparent"></div>
        <div class="relative z-10 p-5 sm:p-7">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#060a12]/80 border border-[#d4af37]/40 backdrop-blur-md font-mono-tech text-[10px] sm:text-[11px] font-semibold text-[#f5df90] mb-2.5 sm:mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            INGENIERÍA Y TRANSPORTE EN CAMPO
          </span>
          <h3 class="font-display text-lg sm:text-xl font-bold text-white leading-snug">
            Operaciones en Provincia Ayopaya, Cochabamba y La Paz
          </h3>
          <p class="text-xs text-slate-300 mt-1.5 leading-relaxed">
            Planificación geológica, servicios de explotación minera y logística de transporte pesado y liviano en alta montaña.
          </p>
        </div>
      </div>

      <!-- Bento Block 3: Cadena Productiva Integral -->
      <article
        class="reveal delay-200 bento-card md:col-span-6 lg:col-span-7 rounded-2xl sm:rounded-3xl p-5 sm:p-8 lg:p-9 flex flex-col justify-between"
      >
        <div class="relative z-10">
          <span class="inline-flex items-center gap-2 px-3 sm:px-3.5 py-1 rounded-full bg-sky-500/15 border border-sky-400/30 font-mono-tech text-[11px] sm:text-xs font-semibold text-sky-300 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
            CADENA PRODUCTIVA Y SERVICIOS
          </span>
          <h3 class="font-display text-xl sm:text-2xl lg:text-3xl font-bold text-white mb-3.5 sm:mb-4">
            Ciclo minero integral y logística especializada
          </h3>
          <p class="text-sm sm:text-base text-slate-300 leading-[1.75] sm:leading-[1.8]">
            {aboutData.pillars[1].text}
          </p>

          <!-- 8-Step Interactive Process Grid -->
          <div class="mt-6 sm:mt-7 grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-2.5">
            {
              valueChainSteps.map((step) => (
                <div class="group rounded-xl bg-white/[0.03] hover:bg-[#d4af37]/15 border border-white/[0.07] hover:border-[#d4af37]/50 p-2.5 sm:p-3 transition-all duration-300 min-w-0">
                  <span class="font-mono-tech text-[9.5px] sm:text-[10px] text-[#d4af37] group-hover:text-[#f5df90] block">
                    FASE {step.code}
                  </span>
                  <span class="font-display text-xs sm:text-sm font-bold text-white mt-0.5 block truncate">
                    {step.name}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </article>

      <!-- Bento Block 4: Cumplimiento AJAM y Ley N° 1333 -->
      <article
        data-tilt
        class="reveal delay-300 bento-card tilt-card md:col-span-12 lg:col-span-5 rounded-2xl sm:rounded-3xl p-5 sm:p-8 lg:p-9 flex flex-col justify-between"
      >
        <div class="relative z-10">
          <div class="flex items-center justify-between gap-3 mb-5 sm:mb-6">
            <span class="inline-flex items-center gap-2 px-3 sm:px-3.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-400/30 font-mono-tech text-[11px] sm:text-xs font-semibold text-emerald-300">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              NORMATIVA Y COMUNIDAD
            </span>
            <svg class="w-6 h-6 text-[#d4af37] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>

          <h3 class="font-display text-xl sm:text-2xl font-bold text-white mb-3.5 sm:mb-4">
            Derechos mineros, medio ambiente y relación comunitaria
          </h3>

          <p class="text-sm sm:text-base text-slate-300 leading-[1.75] sm:leading-[1.8]">
            {aboutData.pillars[2].text}
          </p>
        </div>

        <!-- Compliance Pills -->
        <div class="relative z-10 mt-6 sm:mt-8 pt-5 sm:pt-6 border-t border-white/10 flex flex-wrap gap-2">
          <span class="px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/10 font-mono-tech text-[11px] sm:text-xs text-slate-200">
            AJAM · Derechos Mineros
          </span>
          <span class="px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/10 font-mono-tech text-[11px] sm:text-xs text-slate-200">
            Ley N° 1333 · Medio Ambiente
          </span>
          <span class="px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/10 font-mono-tech text-[11px] sm:text-xs text-slate-200">
            Comunidades Vecinas
          </span>
        </div>
      </article>
    </div>
  </div>
</section>
