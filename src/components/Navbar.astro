---
import Logo from './Logo.astro';
import { navigation } from '../data/company';
---

<header class="fixed top-3 sm:top-5 inset-x-0 z-50 px-3 sm:px-6 pointer-events-none">
  <div
    id="pill-nav"
    class="pointer-events-auto max-w-5xl mx-auto rounded-full bg-[#090f1d]/85 backdrop-blur-xl border border-white/10 shadow-[0_16px_48px_rgba(0,0,0,0.75)] px-3.5 sm:px-6 h-14 sm:h-16 lg:h-[68px] flex items-center justify-between gap-2 transition-all duration-300"
  >
    <a
      href="#"
      class="focus:outline-none focus-visible:ring-2 focus-visible:ring-[#d4af37] rounded-full min-w-0"
      aria-label="Silvadorita - Inicio"
    >
      <Logo variant="pill-nav" />
    </a>

    <!-- Desktop & Tablet Capsule Links -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-1.5 bg-white/[0.03] border border-white/[0.06] rounded-full p-1 lg:p-1.5 shrink-0" aria-label="Navegación principal">
      {
        navigation.slice(0, 3).map((item) => (
          <a
            href={item.href}
            data-nav-link
            class="px-3 lg:px-4 py-1.5 rounded-full text-xs lg:text-[13px] font-semibold text-slate-300 hover:text-white border border-transparent transition-all duration-200 whitespace-nowrap"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Right Action Button (Contacto) -->
    <div class="hidden md:flex items-center shrink-0">
      <a
        href="#contacto"
        class="inline-flex items-center gap-1.5 lg:gap-2 px-4 lg:px-5 py-2 lg:py-2.5 rounded-full text-xs font-bold uppercase tracking-wider text-[#060a12] bg-gradient-to-r from-[#f5df90] via-[#d4af37] to-[#b8860b] hover:brightness-110 shadow-[0_0_24px_rgba(212,175,55,0.35)] transition-all duration-300 whitespace-nowrap"
      >
        <span>Contacto</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Mobile Menu Toggle -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/5 border border-white/10 text-slate-200 hover:text-[#f5df90] hover:border-[#d4af37]/40 transition-colors shrink-0 cursor-pointer"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú de navegación"
    >
      <svg id="menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Floating Glass Menu -->
  <div
    id="mobile-menu"
    class="pointer-events-auto md:hidden hidden mt-2.5 max-w-md mx-auto rounded-3xl bg-[#0b1222]/95 backdrop-blur-2xl border border-white/15 p-4 shadow-[0_24px_60px_rgba(0,0,0,0.9)]"
  >
    <nav class="flex flex-col space-y-1.5" aria-label="Navegación móvil">
      {
        navigation.slice(0, 3).map((item) => (
          <a
            href={item.href}
            data-mobile-link
            class="px-4 py-3 rounded-2xl text-sm font-semibold text-slate-200 hover:bg-white/8 active:bg-white/12 hover:text-[#f5df90] transition-colors flex items-center justify-between"
          >
            <span>{item.label}</span>
            <span class="w-6 h-6 rounded-full bg-[#d4af37]/15 text-[#f5df90] flex items-center justify-center">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))
      }
      <div class="pt-2 mt-1 border-t border-white/10">
        <a
          href="#contacto"
          data-mobile-link
          class="w-full py-3 px-4 rounded-2xl text-xs font-bold uppercase tracking-wider text-[#060a12] bg-gradient-to-r from-[#f5df90] via-[#d4af37] to-[#b8860b] flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(212,175,55,0.3)]"
        >
          <span>Contacto directo</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const pillNav = document.getElementById('pill-nav');

  const closeMenu = () => {
    btn?.setAttribute('aria-expanded', 'false');
    menu?.classList.add('hidden');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  };

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!isExpanded));
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  document.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('click', (e) => {
    if (!menu?.classList.contains('hidden') && !menu?.contains(e.target as Node) && !btn?.contains(e.target as Node)) {
      closeMenu();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  window.addEventListener(
    'scroll',
    () => {
      if (window.scrollY > 24) {
        pillNav?.classList.add('border-[#d4af37]/30', 'bg-[#070b14]/92');
      } else {
        pillNav?.classList.remove('border-[#d4af37]/30', 'bg-[#070b14]/92');
      }
    },
    { passive: true }
  );
</script>
