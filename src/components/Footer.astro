---
import Logo from './Logo.astro';
import { contactData } from '../data/company';
---

<footer id="contacto" class="scroll-mt-24 bg-[#050810] text-white relative overflow-hidden border-t border-white/10">
  <!-- Top Metallic Gold Line -->
  <div class="h-[2px] w-full bg-gradient-to-r from-transparent via-[#d4af37] to-transparent opacity-60"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20 relative z-10">
    <!-- Interactive Contact Bento Card -->
    <div class="reveal bento-card rounded-2xl sm:rounded-3xl p-5 sm:p-8 lg:p-12 mb-8 sm:mb-12">
      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <!-- Left Brand Column -->
        <div class="lg:col-span-5">
          <Logo variant="footer" />
          <p class="mt-4 sm:mt-5 text-sm sm:text-base text-slate-300 leading-relaxed">
            Empresa minera boliviana de origen familiar dedicada al ciclo integral de minerales de wolframio, estaño y oro en Cochabamba y La Paz.
          </p>
          <div class="mt-5 sm:mt-6 inline-flex items-center gap-2 font-mono-tech text-xs text-[#f5df90]">
            <span class="w-2 h-2 rounded-full bg-[#d4af37] shrink-0"></span>
            <span>NIT Y MATRÍCULA: 313716027</span>
          </div>
        </div>

        <!-- Right Contact Cards -->
        <div class="lg:col-span-7">
          <div class="font-mono-tech text-[11px] sm:text-xs font-bold tracking-[0.18em] sm:tracking-[0.2em] text-[#f5df90] uppercase mb-3.5 sm:mb-4">
            04 / CANALES DE CONTACTO OFICIAL
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-4">
            <!-- Address Card (Full Width in Contact Grid) -->
            <div class="sm:col-span-2 rounded-xl sm:rounded-2xl bg-white/[0.03] border border-white/10 p-4 sm:p-5 flex items-start gap-3.5 sm:gap-4 hover:border-[#d4af37]/40 transition-colors">
              <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-[#d4af37]/15 border border-[#d4af37]/30 flex items-center justify-center shrink-0 text-[#f5df90]">
                <svg class="w-4.5 h-4.5 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div class="min-w-0">
                <span class="font-mono-tech text-[10px] sm:text-[11px] text-slate-400 uppercase block">Domicilio Legal</span>
                <span class="text-xs sm:text-base font-semibold text-white mt-0.5 block break-words">
                  {contactData.address}
                </span>
              </div>
            </div>

            <!-- Phone Card -->
            <div class="rounded-xl sm:rounded-2xl bg-white/[0.03] border border-white/10 p-4 sm:p-5 flex items-start gap-3.5 hover:border-[#d4af37]/40 transition-colors">
              <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-[#d4af37]/15 border border-[#d4af37]/30 flex items-center justify-center shrink-0 text-[#f5df90]">
                <svg class="w-4.5 h-4.5 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div class="min-w-0">
                <span class="font-mono-tech text-[10px] sm:text-[11px] text-slate-400 uppercase block">Teléfono</span>
                <span class="text-xs sm:text-sm font-semibold text-white mt-0.5 block break-words">{contactData.phone}</span>
              </div>
            </div>

            <!-- Email Card -->
            <div class="rounded-xl sm:rounded-2xl bg-white/[0.03] border border-white/10 p-4 sm:p-5 flex items-start gap-3.5 hover:border-[#d4af37]/40 transition-colors">
              <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-[#d4af37]/15 border border-[#d4af37]/30 flex items-center justify-center shrink-0 text-[#f5df90]">
                <svg class="w-4.5 h-4.5 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="min-w-0">
                <span class="font-mono-tech text-[10px] sm:text-[11px] text-slate-400 uppercase block">Correo Electrónico</span>
                <span class="text-xs sm:text-sm font-semibold text-white mt-0.5 block break-words">{contactData.email}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left text-[10.5px] sm:text-xs text-slate-400 font-mono-tech">
      <p>© {new Date().getFullYear()} EMPRESA MINERA "SILVADORITA" S.R.L. · TODOS LOS DERECHOS RESERVADOS</p>
      <p>COCHABAMBA — LA PAZ, BOLIVIA</p>
    </div>
  </div>
</footer>
